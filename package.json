{
  "name": "jev-town",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @jev-town/web",
